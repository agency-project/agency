FROM rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0

RUN apt-get update -qq \
 && apt-get install -y -qq ripgrep \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    transformers \
    datasets \
    accelerate \
    numpy \
    scipy \
    scikit-learn \
    matplotlib

# nvidia-smi shim — rocm-smi is available natively in this image so the
# shim routes directly to it instead of using the torch fallback.
COPY images/nvidia-smi-shim-rocm.sh /usr/local/bin/nvidia-smi
RUN chmod +x /usr/local/bin/nvidia-smi

# Ensure a clean, empty workspace.
RUN rm -rf /workspace && mkdir -p /workspace
