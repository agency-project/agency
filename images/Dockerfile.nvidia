FROM nvcr.io/nvidia/pytorch:26.05-py3

RUN apt-get update -qq \
 && apt-get install -y -qq ripgrep \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    transformers \
    datasets \
    accelerate \
    numpy \
    scipy \
    scikit-learn \
    matplotlib

# Pre-cache Qwen/Qwen3.5-0.8B weights and Wikitext-2.
RUN --mount=type=secret,id=hf_token,required=false \
    HF_TOKEN=$(cat /run/secrets/hf_token 2>/dev/null || true) \
    python - <<'EOF'
import os
from huggingface_hub import snapshot_download
from datasets import load_dataset
token = os.environ.get("HF_TOKEN") or None
print("Downloading Qwen/Qwen3.5-0.8B …")
snapshot_download("Qwen/Qwen3.5-0.8B", token=token)
print("Downloading wikitext-2-raw-v1 …")
load_dataset("Salesforce/wikitext", "wikitext-2-raw-v1", split="test", token=token, trust_remote_code=True)
print("Pre-cache complete.")
EOF

# Clean the pre-populated workspace that ships with the NVIDIA base image.
RUN rm -rf /workspace && mkdir -p /workspace

COPY images/model_smoke.py /workspace/model_smoke.py
