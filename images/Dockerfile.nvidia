FROM nvcr.io/nvidia/pytorch:26.05-py3

RUN apt-get update -qq \
 && apt-get install -y -qq ripgrep \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    transformers \
    datasets \
    accelerate \
    numpy \
    scipy \
    scikit-learn \
    matplotlib

# Clean the pre-populated workspace that ships with the NVIDIA base image.
RUN rm -rf /workspace && mkdir -p /workspace
